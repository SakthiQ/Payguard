# PayGuard — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore

# ── MySQL ──────────────────────────────────────────────────
MYSQL_DATABASE=payguard_db
MYSQL_USER=Sakthi
MYSQL_PASSWORD=Sakthi@13809
MYSQL_ROOT_PASSWORD=root_secret

# ── MongoDB ────────────────────────────────────────────────
MONGO_INITDB_DATABASE=payguard_audit

# ── Spring Boot Backend ────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/payguard_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=Sakthi
SPRING_DATASOURCE_PASSWORD=Sakthi@13809
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/payguard_audit
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

